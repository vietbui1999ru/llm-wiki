{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"/claude-setup/scripts/wiki status --brief 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
