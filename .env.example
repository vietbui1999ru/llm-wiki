# This repo does NOT read a .env file. The key lives in ~/secrets/.env and is read
# through the dotfiles secret-get helper (dotfiles/scripts/secret-get). Exporting the
# variable in your shell also works; an exported value wins.
# LLM backend: OpenCode Go (OpenAI-compatible). Unset = no backend: indexing and
# queries exit with a clear error (wiki-index --status still works).
# OPENCODE_GO_API_KEY_LIGHTRAG=...
# Optional overrides:
# OPENCODE_LIGHTRAG_MODEL=deepseek-v4.1-flash
# OPENCODE_LIGHTRAG_BASE_URL=https://opencode.ai/zen/go/v1
# Routing/prefix-cache affinity id, sent as x-opencode-session. Stable so consecutive runs share
# the namespace; set a distinct value to isolate an experiment.
# OPENCODE_LIGHTRAG_SESSION=wiki-index
# Route extraction and synthesis through the local Headroom proxy (docs/headroom.md):
# WIKI_LLM_PROXY_URL=http://127.0.0.1:8787/v1
# deepseek-v4.1-flash is a reasoning model; by default we send thinking={"type":"disabled"} so
# extraction does not burn max_tokens on reasoning. Set to 0 for models that reject the field.
# OPENCODE_LIGHTRAG_DISABLE_THINKING=1
# Reserved for a future self-hosted llama.cpp server (not wired yet; setting it errors):
# LLAMACPP_BASE_URL=
# wiki-chat local backend (default --backend ollama): any tag from `ollama list`.
# WIKI_CHAT_MODEL=gemma4:e4b
