# Copy to .env and fill in your key (or export it from your shell / secrets file).
# wiki-index, wiki-chat, wiki-mcp auto-detect this file; already-exported env vars win.
# LLM backend: OpenCode Go (OpenAI-compatible). Unset = no backend: indexing and
# queries exit with a clear error (wiki-index --status still works).
# OPENCODE_GO_API_KEY_LIGHTRAG=...
# Optional overrides:
# OPENCODE_LIGHTRAG_MODEL=deepseek-v4.1-flash
# OPENCODE_LIGHTRAG_BASE_URL=https://opencode.ai/zen/go/v1
# deepseek-v4.1-flash is a reasoning model; by default we send thinking={"type":"disabled"} so
# extraction does not burn max_tokens on reasoning. Set to 0 for models that reject the field.
# OPENCODE_LIGHTRAG_DISABLE_THINKING=1
# Reserved for a future self-hosted llama.cpp server (not wired yet; setting it errors):
# LLAMACPP_BASE_URL=
