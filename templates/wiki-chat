#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "lightrag-hku>=1.5.7,<1.6",   # tested on 1.5.7; constructor kwargs moved between releases
#   "ollama",
#   "openai",
#   "python-dotenv",
#   "rich",
#   "prompt_toolkit",
#   "numpy",
# ]
# ///
"""wiki-chat — personal wiki AI assistant (LightRAG, hybrid synthesis)

Usage:
  wiki-chat                    interactive Q&A (hybrid graph search)
  wiki-chat --mode local       entity-focused (specific concept questions)
  wiki-chat --mode global      community summaries (cross-concept questions)

Synthesis backend (--backend, default ollama):
  ollama    local model via the Ollama server; short answers
      WIKI_CHAT_MODEL               model tag (default gemma4:e4b; see `ollama list`)
  opencode  remote; first one configured wins:
  LLAMACPP_BASE_URL=...             → self-hosted llama.cpp (RESERVED — not wired yet, errors if set)
  OPENCODE_GO_API_KEY_LIGHTRAG=...  → OpenCode Go (OpenAI-compatible); counts against plan limits
      OPENCODE_LIGHTRAG_MODEL       model id (default deepseek-v4.1-flash)
      OPENCODE_LIGHTRAG_BASE_URL    default https://opencode.ai/zen/go/v1
      OPENCODE_LIGHTRAG_SESSION     routing/prefix-cache affinity id (default: wiki-chat)
  WIKI_LLM_PROXY_URL=...            send synthesis through a local proxy (see docs/headroom.md)
  none configured                   → queries return an error
Embeddings always use ollama (nomic-embed-text). If no Ollama server answers on
127.0.0.1:11434, wiki-chat starts `ollama serve` and stops it on exit; if one was
already running, it is left up and only the chat model is unloaded on exit.

Prompt commands:
  /mode local|global|hybrid|naive   switch query mode mid-session
  /reindex                          re-index changed wiki pages
  /status                           show index stats
  q / exit                          quit
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import subprocess
import sys
import time
from pathlib import Path

try:
    import ollama as _ollama
    from dotenv import load_dotenv
    from lightrag import LightRAG, QueryParam
    from lightrag.llm.ollama import ollama_model_complete
    from lightrag.llm.openai import openai_complete_if_cache
    from lightrag.utils import EmbeddingFunc
    from prompt_toolkit import prompt as pt_prompt
    from prompt_toolkit.history import FileHistory
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.panel import Panel
except ImportError as e:
    print(f"Missing dependency: {e}")
    sys.exit(1)

WIKI_DIR    = Path.home() / "repos/llm-wiki"
load_dotenv(WIKI_DIR / ".env")
WORK_DIR    = WIKI_DIR / ".lightrag"
EMBED_MODEL = "nomic-embed-text"
EMBED_DIM   = 768
VALID_MODES = ("local", "global", "hybrid", "naive")

_API_KEY         = os.environ.get("OPENCODE_GO_API_KEY_LIGHTRAG", "")
_OPENCODE_URL    = os.environ.get("OPENCODE_LIGHTRAG_BASE_URL", "https://opencode.ai/zen/go/v1")
_OPENCODE_MODEL  = os.environ.get("OPENCODE_LIGHTRAG_MODEL", "deepseek-v4.1-flash")
_LOCAL_LLM_URL   = os.environ.get("LLAMACPP_BASE_URL", "")  # empty = no local backend
# deepseek-v4.1-flash reasons by default and can spend the whole max_tokens budget on thinking
# (empty content, finish_reason=length). Send thinking={"type":"disabled"}; set to 0 to omit.
_DISABLE_THINKING = os.environ.get("OPENCODE_LIGHTRAG_DISABLE_THINKING", "1") == "1"

# OpenCode Go asks clients to identify themselves and send a stable session id
# (https://opencode.ai/docs/go/#where-can-i-use-it) so routing/prompt caching work.
# OpenCode Go requires a session id and uses it for routing/prefix-cache affinity.
# Stable by default so consecutive runs share the namespace; override per experiment.
_SESSION = os.environ.get("OPENCODE_LIGHTRAG_SESSION", "wiki-chat")
_PROXY_URL = os.environ.get("WIKI_LLM_PROXY_URL", "")
_BASE_URL = _PROXY_URL or _OPENCODE_URL
_OPENCODE_HEADERS: dict[str, str] = {
    "User-Agent": "llm-wiki-lightrag/1.0",
    "x-opencode-session": _SESSION,
}
if _PROXY_URL:  # stack attribution + session grouping in the proxy's /stats
    _OPENCODE_HEADERS["x-headroom-stack"] = "llm_wiki_chat"
    _OPENCODE_HEADERS["x-headroom-session-id"] = _SESSION

def _preflight_proxy() -> None:
    """Fail closed: a dead or foreign listener must never receive provider credentials.

    /health answers 200 even when unhealthy, so identity comes from /livez (service name) and
    readiness from /readyz. See docs/headroom.md.
    """
    import json as _json
    import urllib.error
    import urllib.request

    root = _PROXY_URL.rstrip("/")
    if root.endswith("/v1"):
        root = root[: -len("/v1")]
    try:
        with urllib.request.urlopen(f"{root}/livez", timeout=3) as resp:
            identity = _json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as exc:  # something answered, but not with an identity document
        raise SystemExit(
            f"{root}/livez answered HTTP {exc.code}; that is not a Headroom proxy. "
            "Refusing to send provider credentials there."
        )
    except Exception as exc:
        raise SystemExit(
            f"Headroom proxy not reachable at {root} ({exc}).\n"
            "Start it (docs/headroom.md) or unset WIKI_LLM_PROXY_URL to call the provider directly."
        )
    if identity.get("service") != "headroom-proxy":
        raise SystemExit(
            f"{root} answered but is not a Headroom proxy (service={identity.get('service')!r}). "
            "Refusing to send provider credentials there."
        )


async def _opencode_llm(prompt, system_prompt=None, history_messages=None, **kwargs):
    kwargs.setdefault("max_tokens", 4096)
    if _DISABLE_THINKING:
        kwargs.setdefault("extra_body", {"thinking": {"type": "disabled"}})
    result = await openai_complete_if_cache(
        _OPENCODE_MODEL, prompt,
        system_prompt=system_prompt,
        history_messages=history_messages or [],
        base_url=_BASE_URL,
        api_key=_API_KEY,
        extra_headers=_OPENCODE_HEADERS,  # per-request; LightRAG overwrites client-level default_headers
        **kwargs,
    )
    if hasattr(result, "__aiter__"):
        return "".join([chunk async for chunk in result])
    return result


async def _no_backend(*args, **kwargs):
    raise RuntimeError("No LLM backend configured. Set OPENCODE_GO_API_KEY_LIGHTRAG (in ~/secrets/.env).")


OLLAMA_URL     = "http://127.0.0.1:11434"
_LOCAL_MODEL   = os.environ.get("WIKI_CHAT_MODEL", "gemma4:e4b")
_LOCAL_NUM_CTX = 16384  # Ollama's default window is too small for LightRAG's retrieved context
SHORT_ANSWER   = "Short answer, 2-4 sentences"
SHORT_PROMPT   = "Answer in at most 4 sentences of plain prose. No headings or bullet lists."

LLM_MODEL, _llm_func, _llm_async, _llm_kwargs = "none", _no_backend, 1, {}


def _select_backend(backend: str) -> None:
    global LLM_MODEL, _llm_func, _llm_async, _llm_kwargs
    if backend == "ollama":
        # think=False: gemma4 thinks by default, which costs latency for no gain on short answers.
        LLM_MODEL, _llm_func, _llm_async = _LOCAL_MODEL, ollama_model_complete, 1
        _llm_kwargs = {"host": OLLAMA_URL, "options": {"num_ctx": _LOCAL_NUM_CTX, "think": False}}
    # Remote selection: local llama.cpp slot (reserved) -> OpenCode Go -> none.
    elif _LOCAL_LLM_URL:
        # TODO: self-hosted llama.cpp (llama-server exposes an OpenAI-compatible /v1 API).
        # Slot is intentionally left empty until an instance exists.
        raise NotImplementedError("llama.cpp backend not wired yet. Unset LLAMACPP_BASE_URL.")
    elif _API_KEY:
        LLM_MODEL, _llm_func, _llm_async = _OPENCODE_MODEL, _opencode_llm, 4

console = Console()


async def _embed(texts: list[str]):
    import numpy as np
    loop = asyncio.get_event_loop()
    resp = await loop.run_in_executor(
        None, lambda: _ollama.embed(model=EMBED_MODEL, input=texts)
    )
    return np.array(resp.embeddings, dtype=np.float32)


def _build_rag() -> LightRAG:
    if not WORK_DIR.exists():
        console.print("[red]Index not found. Run: wiki-index[/red]")
        sys.exit(1)
    return LightRAG(
        working_dir=str(WORK_DIR),
        llm_model_func=_llm_func,
        llm_model_name=LLM_MODEL,
        llm_model_max_async=_llm_async,
        llm_model_kwargs=_llm_kwargs,
        chunk_token_size=800,
        chunk_overlap_token_size=64,
        top_k=20,
        cosine_better_than_threshold=0.3,
        embedding_func=EmbeddingFunc(
            embedding_dim=EMBED_DIM,
            max_token_size=8192,
            func=_embed,
        ),
    )


async def make_rag() -> LightRAG:
    rag = _build_rag()
    await rag.initialize_storages()
    return rag


async def ask(rag: LightRAG, question: str, mode: str) -> None:
    console.print(f"[dim]▸ querying [{mode}]...[/dim]")
    # Context budget stays under _LOCAL_NUM_CTX so the local model sees all of it.
    param = QueryParam(mode=mode, response_type=SHORT_ANSWER,
                       user_prompt=SHORT_PROMPT, max_total_tokens=12000)
    try:
        result = await rag.aquery(question, param=param)
        # LightRAG logs backend failures and returns None; rich.Markdown(None) would then raise.
        if isinstance(result, str) and result.strip():
            console.print(Markdown(result))
        else:
            console.print("[yellow]No answer (see the error above).[/yellow]")
    except Exception as e:
        console.print(f"[red]Query error: {e}[/red]")


def show_index_status() -> None:
    manifest_path = WORK_DIR / "manifest.json"
    if not manifest_path.exists():
        console.print("[yellow]No manifest found. Run: wiki-index[/yellow]")
        return
    manifest = json.loads(manifest_path.read_text())
    pages    = list((WIKI_DIR / "wiki").rglob("*.md"))
    indexed  = sum(1 for p in pages if str(p) in manifest)
    changed  = sum(1 for p in pages
                   if str(p) in manifest and manifest[str(p)] != p.stat().st_mtime)
    console.print(f"[dim]Pages: {len(pages)} total · {indexed} indexed · {changed} changed[/dim]")


async def run(args: argparse.Namespace) -> None:
    mode = args.mode
    rag  = await make_rag()
    hist = FileHistory(str(Path.home() / ".wiki-chat-history"))

    console.print(Panel(
        f"[bold cyan]Wiki Chat[/bold cyan]  [dim]model: {LLM_MODEL} · mode: {mode}[/dim]\n"
        "[dim]/mode local|global|hybrid|naive  /reindex  /status  q to quit[/dim]",
        border_style="cyan",
    ))

    show_index_status()
    if _llm_func is _no_backend:
        console.print("[yellow]No LLM backend configured — set OPENCODE_GO_API_KEY_LIGHTRAG; queries will fail.[/yellow]")

    try:
      while True:
        try:
            # prompt_toolkit's sync prompt() calls asyncio.run(); run it in a thread, not inside our loop
            raw = (await asyncio.to_thread(pt_prompt, "→ ", history=hist)).strip()
        except (KeyboardInterrupt, EOFError):
            break

        if not raw or raw in ("q", "quit", "exit"):
            break

        if raw.startswith("/mode "):
            new_mode = raw.split(None, 1)[1].strip()
            if new_mode in VALID_MODES:
                mode = new_mode
                console.print(f"[dim]mode → {mode}[/dim]")
            else:
                console.print(f"[yellow]Unknown mode. Options: {', '.join(VALID_MODES)}[/yellow]")
            continue

        if raw == "/reindex":
            console.print("[dim]Running wiki-index...[/dim]")
            # subprocess.run is safe here: no shell, no user-controlled args
            result = subprocess.run(
                ["wiki-index"],
                capture_output=True,
                text=True,
            )
            console.print(result.stdout or result.stderr)
            continue

        if raw == "/status":
            show_index_status()
            continue

        await ask(rag, raw, mode)
    finally:
        await rag.finalize_storages()


def _ollama_up() -> bool:
    import urllib.request
    try:
        with urllib.request.urlopen(f"{OLLAMA_URL}/api/version", timeout=1):
            return True
    except Exception:
        return False


def _ensure_ollama() -> subprocess.Popen | None:
    """Start `ollama serve` if nothing is listening; return the process only if we started it."""
    if _ollama_up():
        return None
    console.print("[dim]Starting ollama serve...[/dim]")
    proc = subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        if _ollama_up():
            return proc
        time.sleep(0.2)
    proc.terminate()
    raise SystemExit("ollama serve did not come up on 127.0.0.1:11434 within 10s.")


def _release_ollama(proc: subprocess.Popen | None, backend: str) -> None:
    if proc is not None:  # we own it: shut it down
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        console.print("[dim]ollama stopped.[/dim]")
    elif backend == "ollama":  # someone else's server: just free the model's memory
        subprocess.run(["ollama", "stop", _LOCAL_MODEL], capture_output=True)


def main() -> None:
    parser = argparse.ArgumentParser(description="wiki-chat: graph-aware wiki assistant")
    parser.add_argument("--mode", choices=VALID_MODES, default="hybrid")
    parser.add_argument("--backend", choices=("ollama", "opencode"), default="ollama")
    args = parser.parse_args()
    _select_backend(args.backend)
    if args.backend == "opencode" and _PROXY_URL:
        _preflight_proxy()
    proc = _ensure_ollama()  # embeddings need it on every backend
    try:
        asyncio.run(run(args))
    except KeyboardInterrupt:
        pass
    finally:
        _release_ollama(proc, args.backend)


if __name__ == "__main__":
    main()
