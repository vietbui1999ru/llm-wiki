#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "lightrag-hku>=1.5.7,<1.6",   # tested on 1.5.7; constructor kwargs moved between releases
#   "ollama",
#   "openai",
#   "python-dotenv",
#   "rich",
#   "prompt_toolkit",
#   "numpy",
# ]
# ///
"""wiki-chat — personal wiki AI assistant (LightRAG, hybrid synthesis)

Usage:
  wiki-chat                    interactive Q&A (hybrid graph search)
  wiki-chat --mode local       entity-focused (specific concept questions)
  wiki-chat --mode global      community summaries (cross-concept questions)

Synthesis backend (first one configured wins):
  LLAMACPP_BASE_URL=...             → self-hosted llama.cpp (RESERVED — not wired yet, errors if set)
  OPENCODE_GO_API_KEY_LIGHTRAG=...  → OpenCode Go (OpenAI-compatible); counts against plan limits
      OPENCODE_LIGHTRAG_MODEL       model id (default deepseek-v4.1-flash)
      OPENCODE_LIGHTRAG_BASE_URL    default https://opencode.ai/zen/go/v1
  none configured                   → queries return an error
Embeddings still use ollama (nomic-embed-text); no local LLM is used.

Prompt commands:
  /mode local|global|hybrid|naive   switch query mode mid-session
  /reindex                          re-index changed wiki pages
  /status                           show index stats
  q / exit                          quit
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import subprocess
import sys
from pathlib import Path

try:
    import ollama as _ollama
    from dotenv import load_dotenv
    from lightrag import LightRAG, QueryParam
    from lightrag.llm.openai import openai_complete_if_cache
    from lightrag.utils import EmbeddingFunc
    from prompt_toolkit import prompt as pt_prompt
    from prompt_toolkit.history import FileHistory
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.panel import Panel
except ImportError as e:
    print(f"Missing dependency: {e}")
    sys.exit(1)

WIKI_DIR    = Path.home() / "repos/llm-wiki"
load_dotenv(WIKI_DIR / ".env")
WORK_DIR    = WIKI_DIR / ".lightrag"
EMBED_MODEL = "nomic-embed-text"
EMBED_DIM   = 768
VALID_MODES = ("local", "global", "hybrid", "naive")

_API_KEY         = os.environ.get("OPENCODE_GO_API_KEY_LIGHTRAG", "")
_OPENCODE_URL    = os.environ.get("OPENCODE_LIGHTRAG_BASE_URL", "https://opencode.ai/zen/go/v1")
_OPENCODE_MODEL  = os.environ.get("OPENCODE_LIGHTRAG_MODEL", "deepseek-v4.1-flash")
_LOCAL_LLM_URL   = os.environ.get("LLAMACPP_BASE_URL", "")  # empty = no local backend
# deepseek-v4.1-flash reasons by default and can spend the whole max_tokens budget on thinking
# (empty content, finish_reason=length). Send thinking={"type":"disabled"}; set to 0 to omit.
_DISABLE_THINKING = os.environ.get("OPENCODE_LIGHTRAG_DISABLE_THINKING", "1") == "1"

# OpenCode Go asks clients to identify themselves and send a stable session id
# (https://opencode.ai/docs/go/#where-can-i-use-it) so routing/prompt caching work.
_OPENCODE_HEADERS = {"User-Agent": "llm-wiki-lightrag/1.0", "x-opencode-session": f"wiki-chat-{os.getpid()}"}


async def _opencode_llm(prompt, system_prompt=None, history_messages=None, **kwargs):
    kwargs.setdefault("max_tokens", 4096)
    if _DISABLE_THINKING:
        kwargs.setdefault("extra_body", {"thinking": {"type": "disabled"}})
    result = await openai_complete_if_cache(
        _OPENCODE_MODEL, prompt,
        system_prompt=system_prompt,
        history_messages=history_messages or [],
        base_url=_OPENCODE_URL,
        api_key=_API_KEY,
        extra_headers=_OPENCODE_HEADERS,  # per-request; LightRAG overwrites client-level default_headers
        **kwargs,
    )
    if hasattr(result, "__aiter__"):
        return "".join([chunk async for chunk in result])
    return result


async def _no_backend(*args, **kwargs):
    raise RuntimeError("No LLM backend configured. Set OPENCODE_GO_API_KEY_LIGHTRAG (in ~/secrets/.env).")


# Selection: local llama.cpp slot (reserved) -> OpenCode Go -> none.
if _LOCAL_LLM_URL:
    # TODO: self-hosted llama.cpp (llama-server exposes an OpenAI-compatible /v1 API).
    # Slot is intentionally left empty until an instance exists.
    raise NotImplementedError("llama.cpp backend not wired yet. Unset LLAMACPP_BASE_URL.")
elif _API_KEY:
    LLM_MODEL  = _OPENCODE_MODEL
    _llm_func  = _opencode_llm
    _llm_async = 4
else:
    LLM_MODEL  = "none"
    _llm_func  = _no_backend
    _llm_async = 1

console = Console()


async def _embed(texts: list[str]):
    import numpy as np
    loop = asyncio.get_event_loop()
    resp = await loop.run_in_executor(
        None, lambda: _ollama.embed(model=EMBED_MODEL, input=texts)
    )
    return np.array(resp.embeddings, dtype=np.float32)


def _build_rag() -> LightRAG:
    if not WORK_DIR.exists():
        console.print("[red]Index not found. Run: wiki-index[/red]")
        sys.exit(1)
    return LightRAG(
        working_dir=str(WORK_DIR),
        llm_model_func=_llm_func,
        llm_model_name=LLM_MODEL,
        llm_model_max_async=_llm_async,
        chunk_token_size=800,
        chunk_overlap_token_size=64,
        top_k=20,
        cosine_better_than_threshold=0.3,
        embedding_func=EmbeddingFunc(
            embedding_dim=EMBED_DIM,
            max_token_size=8192,
            func=_embed,
        ),
    )


async def make_rag() -> LightRAG:
    rag = _build_rag()
    await rag.initialize_storages()
    return rag


async def ask(rag: LightRAG, question: str, mode: str) -> None:
    console.print(f"[dim]▸ querying [{mode}]...[/dim]")
    try:
        result = await rag.aquery(question, param=QueryParam(mode=mode))
        console.print(Markdown(result))
    except Exception as e:
        console.print(f"[red]Query error: {e}[/red]")


def show_index_status() -> None:
    manifest_path = WORK_DIR / "manifest.json"
    if not manifest_path.exists():
        console.print("[yellow]No manifest found. Run: wiki-index[/yellow]")
        return
    manifest = json.loads(manifest_path.read_text())
    pages    = list((WIKI_DIR / "wiki").rglob("*.md"))
    indexed  = sum(1 for p in pages if str(p) in manifest)
    changed  = sum(1 for p in pages
                   if str(p) in manifest and manifest[str(p)] != p.stat().st_mtime)
    console.print(f"[dim]Pages: {len(pages)} total · {indexed} indexed · {changed} changed[/dim]")


async def run(args: argparse.Namespace) -> None:
    mode = args.mode
    rag  = await make_rag()
    hist = FileHistory(str(Path.home() / ".wiki-chat-history"))

    console.print(Panel(
        f"[bold cyan]Wiki Chat[/bold cyan]  [dim]model: {LLM_MODEL} · mode: {mode}[/dim]\n"
        "[dim]/mode local|global|hybrid|naive  /reindex  /status  q to quit[/dim]",
        border_style="cyan",
    ))

    show_index_status()
    if _llm_func is _no_backend:
        console.print("[yellow]No LLM backend configured — set OPENCODE_GO_API_KEY_LIGHTRAG; queries will fail.[/yellow]")

    try:
      while True:
        try:
            # prompt_toolkit's sync prompt() calls asyncio.run(); run it in a thread, not inside our loop
            raw = (await asyncio.to_thread(pt_prompt, "→ ", history=hist)).strip()
        except (KeyboardInterrupt, EOFError):
            break

        if not raw or raw in ("q", "quit", "exit"):
            break

        if raw.startswith("/mode "):
            new_mode = raw.split(None, 1)[1].strip()
            if new_mode in VALID_MODES:
                mode = new_mode
                console.print(f"[dim]mode → {mode}[/dim]")
            else:
                console.print(f"[yellow]Unknown mode. Options: {', '.join(VALID_MODES)}[/yellow]")
            continue

        if raw == "/reindex":
            console.print("[dim]Running wiki-index...[/dim]")
            # subprocess.run is safe here: no shell, no user-controlled args
            result = subprocess.run(
                ["wiki-index"],
                capture_output=True,
                text=True,
            )
            console.print(result.stdout or result.stderr)
            continue

        if raw == "/status":
            show_index_status()
            continue

        await ask(rag, raw, mode)
    finally:
        await rag.finalize_storages()


def main() -> None:
    parser = argparse.ArgumentParser(description="wiki-chat: graph-aware wiki assistant")
    parser.add_argument("--mode", choices=VALID_MODES, default="hybrid")
    args = parser.parse_args()
    asyncio.run(run(args))


if __name__ == "__main__":
    main()
