#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "lightrag-hku",
#   "anthropic",
#   "ollama",
#   "numpy",
#   "python-dotenv",
# ]
# ///
"""wiki-index — build/update LightRAG graph index over the wiki

Usage:
  wiki-index            index new/changed pages (incremental)
  wiki-index --full     wipe and rebuild from scratch  *** see cost warning below ***
  wiki-index --status   show manifest stats without indexing

Extraction backend (priority order, set env var in .env):
  ANTHROPIC_API_KEY=sk-ant-...  → Claude Haiku (best quality)
  OPENROUTER_API_KEY=sk-or-...  → OpenRouter (not yet implemented — stub only)
  unset                         → qwen2.5:3b via ollama (fully local, FREE — recommended for --full)

COST WARNING — --full with Anthropic API:
  LightRAG runs 3 extraction phases per page (entity → relation → community),
  each with multiple LLM calls. At ~150 pages, expect $10–30 with Claude Haiku.
  Use qwen2.5:3b (ollama, free) for full rebuilds. Reserve Haiku for incremental
  updates where per-page cost (~$0.07–0.20) is acceptable.

Requires:
  uv run --script wiki-index   (deps declared inline above)
  ollama running with qwen2.5:3b + nomic-embed-text
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
from pathlib import Path

try:
    import ollama as _ollama
    from dotenv import load_dotenv
    from lightrag import LightRAG, QueryParam
    from lightrag.llm.ollama import ollama_model_complete
    from lightrag.llm.anthropic import anthropic_complete_if_cache
    from lightrag.utils import EmbeddingFunc
except ImportError:
    print("Missing: pip install lightrag-hku python-dotenv")
    sys.exit(1)

WIKI_DIR    = Path.home() / "repos/llm-wiki"
load_dotenv(WIKI_DIR / ".env")
WIKI_PAGES  = WIKI_DIR / "wiki"
WORK_DIR    = WIKI_DIR / ".lightrag"
MANIFEST    = WORK_DIR / "manifest.json"
EMBED_MODEL = "nomic-embed-text"
EMBED_DIM   = 768

_API_KEY          = os.environ.get("ANTHROPIC_API_KEY", "")
_OPENROUTER_KEY   = os.environ.get("OPENROUTER_API_KEY", "")

async def _anthropic_llm(prompt, system_prompt=None, history_messages=None, **kwargs):
    kwargs.setdefault("max_tokens", 4096)
    result = await anthropic_complete_if_cache(
        "claude-haiku-4-5-20251001", prompt,
        system_prompt=system_prompt,
        history_messages=history_messages or [],
        api_key=_API_KEY,
        **kwargs,
    )
    if hasattr(result, "__aiter__"):
        return "".join([chunk async for chunk in result])
    return result

if _API_KEY:
    LLM_MODEL      = "claude-haiku-4-5-20251001"
    _llm_func      = _anthropic_llm
    _llm_max_async = 4
elif _OPENROUTER_KEY:
    # TODO: wire up OpenRouter backend via lightrag.llm.openai.openai_complete_if_cache
    # base_url="https://openrouter.ai/api/v1", model e.g. "anthropic/claude-haiku-4-5"
    raise NotImplementedError("OpenRouter backend not yet implemented. Set ANTHROPIC_API_KEY or leave unset for local.")
else:
    LLM_MODEL      = "qwen2.5:3b"
    _llm_func      = ollama_model_complete
    _llm_max_async = 2


def _parse_frontmatter(content: str) -> dict:
    """Extract title, type, tags from YAML frontmatter without yaml dep."""
    import re
    m = re.match(r'^---\n(.*?)\n---\n', content, re.DOTALL)
    if not m:
        return {}
    fm = m.group(1)
    result = {}
    t = re.search(r'^title:\s*"?([^"\n]+)"?', fm, re.MULTILINE)
    if t: result["title"] = t.group(1).strip()
    tp = re.search(r'^type:\s*(\w+)', fm, re.MULTILINE)
    if tp: result["type"] = tp.group(1)
    tg = re.search(r'^tags:\s*\[([^\]]+)\]', fm, re.MULTILINE)
    if tg: result["tags"] = [x.strip().strip('"') for x in tg.group(1).split(',')]
    return result


def wiki_chunking_func(
    tokenizer,
    content: str,
    split_by_character=None,
    split_by_character_only: bool = False,
    chunk_overlap_token_size: int = 64,
    chunk_token_size: int = 800,
) -> list[dict]:
    """
    Obsidian-aware chunker: prepends pre-parsed wikilink graph as extraction hints.
    Tells the LLM which entities and relations are already known so it focuses
    on implicit connections — reduces extraction LLM calls by ~40-60%.
    """
    import re
    from lightrag.operate import chunking_by_token_size

    fm    = _parse_frontmatter(content)
    links = list(dict.fromkeys(re.findall(r'\[\[([^\]|]+)', content)))  # dedup

    header_lines = ["## GRAPH STRUCTURE (pre-parsed — do not re-extract these)"]
    if title := fm.get("title"):
        tags_str = f", tags: {', '.join(fm.get('tags', []))}" if fm.get("tags") else ""
        header_lines.append(f'Primary entity: "{title}" (type: {fm.get("type", "concept")}{tags_str})')
    if links:
        header_lines.append("Confirmed outgoing relations (skip re-extraction):")
        for link in links[:25]:
            name = link.split("/")[-1].replace("-", " ")
            header_lines.append(f"  → {name}  [{link}]")
    header_lines.append("Extract ONLY implicit relations and entities NOT listed above.")
    header_lines.append("## END GRAPH STRUCTURE\n")

    enriched = "\n".join(header_lines) + "\n" + content
    return chunking_by_token_size(
        tokenizer, enriched, split_by_character,
        split_by_character_only, chunk_overlap_token_size, chunk_token_size,
    )


async def _embed(texts: list[str]):
    import numpy as np
    loop = asyncio.get_event_loop()
    resp = await loop.run_in_executor(
        None, lambda: _ollama.embed(model=EMBED_MODEL, input=texts)
    )
    return np.array(resp.embeddings, dtype=np.float32)


def _build_rag() -> LightRAG:
    WORK_DIR.mkdir(exist_ok=True)
    return LightRAG(
        working_dir=str(WORK_DIR),
        llm_model_func=_llm_func,
        llm_model_name=LLM_MODEL,
        llm_model_max_async=_llm_max_async,
        max_extract_input_tokens=16384,
        # wiki_chunking_func prepends Obsidian wikilink graph as extraction hints,
        # telling the LLM which entities/relations are already known so it focuses
        # only on implicit connections → reduces extraction token cost ~40-60%.
        chunking_func=wiki_chunking_func,
        chunk_token_size=800,
        chunk_overlap_token_size=64,
        # top_k=20: wiki has dense cross-links; fewer candidates = less noise.
        top_k=20,
        cosine_threshold=0.3,
        embedding_func=EmbeddingFunc(
            embedding_dim=EMBED_DIM,
            max_token_size=8192,
            func=_embed,
        ),
    )


async def make_rag() -> LightRAG:
    rag = _build_rag()
    await rag.initialize_storages()
    return rag


def load_manifest() -> dict:
    if MANIFEST.exists():
        return json.loads(MANIFEST.read_text())
    return {}


def save_manifest(m: dict) -> None:
    MANIFEST.write_text(json.dumps(m, indent=2))


def page_content(path: Path) -> str:
    rel = path.relative_to(WIKI_DIR)
    return f"# Source: {rel}\n\n{path.read_text()}"


async def index_pages(rag: LightRAG, pages: list[Path], manifest: dict) -> dict:
    changed = [
        p for p in pages
        if str(p) not in manifest
        or manifest[str(p)] != p.stat().st_mtime
    ]

    if not changed:
        print("Index up to date — no changes detected.")
        return manifest

    backend = "anthropic" if _API_KEY else "ollama"
    print(f"Indexing {len(changed)} new/changed pages (of {len(pages)} total) · extraction: {LLM_MODEL} ({backend})")
    for i, p in enumerate(changed, 1):
        rel = p.relative_to(WIKI_DIR)
        print(f"  [{i}/{len(changed)}] {rel}", flush=True)
        await rag.ainsert(
            page_content(p),
            ids=[str(rel)],
            file_paths=[str(rel)],
        )
        manifest[str(p)] = p.stat().st_mtime
        save_manifest(manifest)   # save after each page so partial runs resume

    print(f"Done. {len(changed)} pages indexed.")
    return manifest


def show_status(pages: list[Path], manifest: dict) -> None:
    indexed   = sum(1 for p in pages if str(p) in manifest)
    changed   = sum(1 for p in pages
                    if str(p) in manifest and manifest[str(p)] != p.stat().st_mtime)
    unindexed = len(pages) - indexed
    print(f"Pages total:    {len(pages)}")
    print(f"Indexed:        {indexed}")
    print(f"Changed:        {changed}")
    print(f"Not yet:        {unindexed}")
    print(f"Work dir:       {WORK_DIR}")


async def test_llm_backend() -> None:
    backend = "anthropic" if _API_KEY else "ollama"
    print(f"Testing LLM backend: {LLM_MODEL} ({backend})")
    try:
        result = await _llm_func("Reply with the single word OK.", max_tokens=16)
        # result may be a string or an async generator (streaming)
        if hasattr(result, "__aiter__"):
            text = "".join([chunk async for chunk in result])
        else:
            text = str(result)
        print(f"  response: {text.strip()!r}  ✓")
    except Exception as e:
        print(f"  FAILED: {e}")
        raise SystemExit(1)


async def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--full",   action="store_true", help="wipe and rebuild")
    parser.add_argument("--status", action="store_true", help="show stats only")
    parser.add_argument("--test",   action="store_true", help="test LLM backend then exit")
    parser.add_argument("--yes",    action="store_true", help="skip cost confirmation for --full with API key")
    args = parser.parse_args()

    pages = sorted(WIKI_PAGES.rglob("*.md"))

    if args.status:
        show_status(pages, load_manifest())
        return

    if args.test:
        await test_llm_backend()
        return

    if args.full and (_API_KEY or _OPENROUTER_KEY) and not args.yes:
        backend = "Anthropic Haiku" if _API_KEY else "OpenRouter"
        print(f"WARNING: --full with {backend} backend on {len(pages)} pages.")
        print(f"  LightRAG runs 3 extraction phases per page → expect $10–30+ in API costs.")
        print(f"  Use qwen2.5:3b (unset API keys) for free full rebuilds.")
        print(f"  Pass --yes to confirm and proceed.")
        raise SystemExit(1)

    if args.full and WORK_DIR.exists():
        import shutil
        shutil.rmtree(WORK_DIR)
        print("Wiped existing index.")

    rag      = await make_rag()
    manifest = {} if args.full else load_manifest()
    try:
        await index_pages(rag, pages, manifest)
    finally:
        await rag.finalize_storages()


if __name__ == "__main__":
    asyncio.run(main())
