#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "lightrag-hku>=1.5.7,<1.6",   # tested on 1.5.7; chunker/constructor kwargs moved between releases
#   "openai",
#   "ollama",
#   "numpy",
#   "python-dotenv",
# ]
# ///
"""wiki-index — build/update LightRAG graph index over the wiki

Usage:
  wiki-index            index new/changed pages (incremental)
  wiki-index --full     wipe and rebuild from scratch  *** see usage note below ***
  wiki-index --status   show manifest stats without indexing

Extraction backend (first one configured wins; set env vars in secrets/.env):
  LLAMACPP_BASE_URL=...             → self-hosted llama.cpp (RESERVED — not wired yet, errors if set)
  OPENCODE_GO_API_KEY_LIGHTRAG=...  → OpenCode Go (OpenAI-compatible, flat monthly plan)
      OPENCODE_LIGHTRAG_MODEL       model id (default deepseek-v4.1-flash)
      OPENCODE_LIGHTRAG_BASE_URL    default https://opencode.ai/zen/go/v1
      OPENCODE_LIGHTRAG_DISABLE_THINKING  default 1: send thinking={"type":"disabled"}; set 0 to omit
  OPENROUTER_API_KEY=sk-or-...      → OpenRouter (not yet implemented — stub only)
  none configured                   → indexing/--test exit with an error; --status still works

USAGE NOTE — --full with OpenCode Go:
  LightRAG runs 3 extraction phases per page (entity → relation → community),
  each with multiple LLM calls. Go plans cap usage at 5-hour / weekly / monthly
  dollar limits per model, so a --full rebuild can exhaust the 5-hour window.
  Limits: https://opencode.ai/docs/go/#usage-limits

Requires:
  uv run --script wiki-index   (deps declared inline above)
  ollama running with nomic-embed-text (embeddings only; no local LLM is used)
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
from pathlib import Path

try:
    import ollama as _ollama
    from dotenv import load_dotenv
    from lightrag import LightRAG, QueryParam
    from lightrag.base import DocStatus
    from lightrag.llm.openai import openai_complete_if_cache
    from lightrag.utils import EmbeddingFunc, sanitize_text_for_encoding
except ImportError:
    print("Missing: pip install lightrag-hku python-dotenv")
    sys.exit(1)

WIKI_DIR    = Path.home() / "repos/llm-wiki"
load_dotenv(WIKI_DIR / ".env")
WIKI_PAGES  = WIKI_DIR / "wiki"
WORK_DIR    = WIKI_DIR / ".lightrag"
MANIFEST    = WORK_DIR / "manifest.json"
EMBED_MODEL = "nomic-embed-text"
EMBED_DIM   = 768

_API_KEY          = os.environ.get("OPENCODE_GO_API_KEY_LIGHTRAG", "")
_OPENCODE_URL     = os.environ.get("OPENCODE_LIGHTRAG_BASE_URL", "https://opencode.ai/zen/go/v1")
_OPENCODE_MODEL   = os.environ.get("OPENCODE_LIGHTRAG_MODEL", "deepseek-v4.1-flash")
_OPENROUTER_KEY   = os.environ.get("OPENROUTER_API_KEY", "")
# deepseek-v4.1-flash reasons by default and spends the whole max_tokens budget on thinking for
# extraction prompts (empty content, finish_reason=length). Send thinking={"type":"disabled"}
# (probed: 2774 -> 185 completion tokens on a sample prompt). Set to 0 for models that reject it.
_DISABLE_THINKING = os.environ.get("OPENCODE_LIGHTRAG_DISABLE_THINKING", "1") == "1"

# OpenCode Go asks clients to identify themselves and send a stable session id
# (https://opencode.ai/docs/go/#where-can-i-use-it) so routing/prompt caching work.
_OPENCODE_HEADERS = {"User-Agent": "llm-wiki-lightrag/1.0", "x-opencode-session": f"wiki-index-{os.getpid()}"}

async def _opencode_llm(prompt, system_prompt=None, history_messages=None, **kwargs):
    kwargs.setdefault("max_tokens", 4096)
    if _DISABLE_THINKING:
        kwargs.setdefault("extra_body", {"thinking": {"type": "disabled"}})
    result = await openai_complete_if_cache(
        _OPENCODE_MODEL, prompt,
        system_prompt=system_prompt,
        history_messages=history_messages or [],
        base_url=_OPENCODE_URL,
        api_key=_API_KEY,
        extra_headers=_OPENCODE_HEADERS,  # per-request; LightRAG overwrites client-level default_headers
        **kwargs,
    )
    if hasattr(result, "__aiter__"):
        return "".join([chunk async for chunk in result])
    return result

_NO_BACKEND_MSG = "No LLM backend configured. Set OPENCODE_GO_API_KEY_LIGHTRAG (in ~/secrets/.env)."

async def _no_backend(*args, **kwargs):
    raise RuntimeError(_NO_BACKEND_MSG)

# Selection: local llama.cpp slot (reserved) -> OpenCode Go -> none.
_LOCAL_LLM_URL = os.environ.get("LLAMACPP_BASE_URL", "")  # empty = no local backend

if _LOCAL_LLM_URL:
    # TODO: self-hosted llama.cpp (llama-server exposes an OpenAI-compatible /v1 API).
    # Slot is intentionally left empty until an instance exists.
    raise NotImplementedError("llama.cpp backend not wired yet. Unset LLAMACPP_BASE_URL.")
elif _API_KEY:
    LLM_MODEL      = _OPENCODE_MODEL
    _llm_func      = _opencode_llm
    _llm_max_async = 4
elif _OPENROUTER_KEY:
    # TODO: wire up OpenRouter backend via lightrag.llm.openai.openai_complete_if_cache
    # base_url="https://openrouter.ai/api/v1"
    raise NotImplementedError("OpenRouter backend not yet implemented. Set OPENCODE_GO_API_KEY_LIGHTRAG.")
else:
    LLM_MODEL      = "none"
    _llm_func      = _no_backend
    _llm_max_async = 1


def _parse_frontmatter(content: str) -> dict:
    """Extract title, type, tags from YAML frontmatter without yaml dep."""
    import re
    m = re.match(r'^---\n(.*?)\n---\n', content, re.DOTALL)
    if not m:
        return {}
    fm = m.group(1)
    result = {}
    t = re.search(r'^title:\s*"?([^"\n]+)"?', fm, re.MULTILINE)
    if t: result["title"] = t.group(1).strip()
    tp = re.search(r'^type:\s*(\w+)', fm, re.MULTILINE)
    if tp: result["type"] = tp.group(1)
    tg = re.search(r'^tags:\s*\[([^\]]+)\]', fm, re.MULTILINE)
    if tg: result["tags"] = [x.strip().strip('"') for x in tg.group(1).split(',')]
    return result


def wiki_chunking_func(
    tokenizer,
    content: str,
    split_by_character=None,
    split_by_character_only: bool = False,
    chunk_overlap_token_size: int = 64,
    chunk_token_size: int = 800,
) -> list[dict]:
    """
    Obsidian-aware chunker: prepends pre-parsed wikilink graph as extraction hints.
    Tells the LLM which entities and relations are already known so it focuses
    on implicit connections — reduces extraction LLM calls by ~40-60%.
    """
    import re
    from lightrag.chunker import chunking_by_token_size

    fm    = _parse_frontmatter(content)
    links = list(dict.fromkeys(re.findall(r'\[\[([^\]|]+)', content)))  # dedup

    header_lines = ["## GRAPH STRUCTURE (pre-parsed — do not re-extract these)"]
    if title := fm.get("title"):
        tags_str = f", tags: {', '.join(fm.get('tags', []))}" if fm.get("tags") else ""
        header_lines.append(f'Primary entity: "{title}" (type: {fm.get("type", "concept")}{tags_str})')
    if links:
        header_lines.append("Confirmed outgoing relations (skip re-extraction):")
        for link in links[:25]:
            name = link.split("/")[-1].replace("-", " ")
            header_lines.append(f"  → {name}  [{link}]")
    header_lines.append("Extract ONLY implicit relations and entities NOT listed above.")
    header_lines.append("## END GRAPH STRUCTURE\n")

    enriched = "\n".join(header_lines) + "\n" + content
    return chunking_by_token_size(
        tokenizer, enriched, split_by_character,
        split_by_character_only, chunk_overlap_token_size, chunk_token_size,
    )


async def _embed(texts: list[str]):
    import numpy as np
    loop = asyncio.get_event_loop()
    resp = await loop.run_in_executor(
        None, lambda: _ollama.embed(model=EMBED_MODEL, input=texts)
    )
    return np.array(resp.embeddings, dtype=np.float32)


def _build_rag() -> LightRAG:
    WORK_DIR.mkdir(exist_ok=True)
    return LightRAG(
        working_dir=str(WORK_DIR),
        llm_model_func=_llm_func,
        llm_model_name=LLM_MODEL,
        llm_model_max_async=_llm_max_async,
        # wiki_chunking_func prepends Obsidian wikilink graph as extraction hints,
        # telling the LLM which entities/relations are already known so it focuses
        # only on implicit connections → reduces extraction token cost ~40-60%.
        chunking_func=wiki_chunking_func,
        chunk_token_size=800,
        chunk_overlap_token_size=64,
        # top_k=20: wiki has dense cross-links; fewer candidates = less noise.
        top_k=20,
        cosine_better_than_threshold=0.3,
        embedding_func=EmbeddingFunc(
            embedding_dim=EMBED_DIM,
            max_token_size=8192,
            func=_embed,
        ),
    )


async def make_rag() -> LightRAG:
    rag = _build_rag()
    await rag.initialize_storages()
    return rag


def load_manifest() -> dict:
    if MANIFEST.exists():
        return json.loads(MANIFEST.read_text())
    return {}


def save_manifest(m: dict) -> None:
    MANIFEST.write_text(json.dumps(m, indent=2))


def page_content(path: Path) -> str:
    rel = path.relative_to(WIKI_DIR)
    return f"# Source: {rel}\n\n{path.read_text()}"


def _file_name(rel: Path) -> str:
    """LightRAG treats a repeated file *basename* as a duplicate and silently drops the insert,
    so every page gets a path-unique name. The doc id stays the page's relative path."""
    return str(rel).replace("/", "__")


async def _index_one(rag: LightRAG, p: Path) -> str | None:
    """(Re)index one page. Returns None on success, otherwise the reason it failed."""
    rel = p.relative_to(WIKI_DIR)
    doc_id, content = str(rel), page_content(p)
    if await rag.doc_status.get_by_id(doc_id):  # changed page or earlier failure: replace, not re-insert
        res = await rag.adelete_by_doc_id(doc_id)
        if res.status not in ("success", "not_found"):
            return f"could not remove the old version: {res.message}"
    await rag.ainsert(content, ids=[doc_id], file_paths=[_file_name(rel)])
    # ainsert logs pipeline errors instead of raising and silently skips duplicates: check what was stored.
    doc = await rag.doc_status.get_by_id(doc_id)
    status = getattr(doc.get("status"), "value", doc.get("status")) if doc else None
    if status != "processed":
        return (doc or {}).get("error_msg") or f"status {status}"
    stored = await rag.full_docs.get_by_id(doc_id)
    if not stored or stored.get("content") != sanitize_text_for_encoding(content):  # LightRAG sanitizes on insert
        return "stored text does not match the page (the insert was skipped)"
    return None


async def index_pages(rag: LightRAG, pages: list[Path], manifest: dict) -> dict:
    changed = [
        p for p in pages
        if str(p) not in manifest
        or manifest[str(p)] != p.stat().st_mtime
    ]

    if not changed:
        print("Index up to date — no changes detected.")
        return manifest

    print(f"Indexing {len(changed)} new/changed pages (of {len(pages)} total) · extraction: {LLM_MODEL} (opencode-go)")
    failed = []
    for i, p in enumerate(changed, 1):
        rel = p.relative_to(WIKI_DIR)
        print(f"  [{i}/{len(changed)}] {rel}", flush=True)
        reason = await _index_one(rag, p)
        if reason:  # only record pages that really made it in, otherwise they are never retried
            print(f"    FAILED: {reason}", flush=True)
            failed.append(rel)
            continue
        manifest[str(p)] = p.stat().st_mtime
        save_manifest(manifest)   # save after each page so partial runs resume

    print(f"Done. {len(changed) - len(failed)} pages indexed, {len(failed)} failed.")
    if failed:
        raise SystemExit(1)
    return manifest


async def remove_deleted_pages(rag: LightRAG, manifest: dict) -> None:
    """Drop pages that no longer exist on disk from the index and the manifest."""
    for path in [k for k in manifest if not Path(k).exists()]:
        doc_id = str(Path(path).relative_to(WIKI_DIR))
        res = await rag.adelete_by_doc_id(doc_id)
        if res.status in ("success", "not_found"):
            print(f"  removed deleted page: {doc_id}", flush=True)
            del manifest[path]
            save_manifest(manifest)
        else:
            print(f"  could not remove {doc_id}: {res.message}", flush=True)


async def find_problems(rag: LightRAG, pages: list[Path], manifest: dict) -> list[tuple[str, str]]:
    """Compare the index with the wiki on disk. Returns (doc id, problem) pairs."""
    problems = []
    for p in pages:
        doc_id = str(p.relative_to(WIKI_DIR))
        doc = await rag.doc_status.get_by_id(doc_id)
        status = getattr(doc.get("status"), "value", doc.get("status")) if doc else None
        if not doc:
            problems.append((doc_id, "missing from the index"))
        elif status != "processed":
            problems.append((doc_id, f"status {status}"))
        elif (await rag.full_docs.get_by_id(doc_id) or {}).get("content") != sanitize_text_for_encoding(page_content(p)):
            problems.append((doc_id, "stored text is stale"))
    problems += [(str(Path(k).relative_to(WIKI_DIR)), "deleted page still indexed")
                 for k in manifest if not Path(k).exists()]
    failed = await rag.doc_status.get_docs_by_statuses([DocStatus.FAILED])
    problems += [(k, "stray rejected-duplicate record") for k in failed if k.startswith("dup-")]
    return problems


async def reconcile(rag: LightRAG, problems: list[tuple[str, str]], manifest: dict) -> None:
    """Repair what find_problems() reported."""
    for key, why in problems:
        if why == "stray rejected-duplicate record":
            await rag.doc_status.delete([key])
        elif why == "deleted page still indexed":
            await remove_deleted_pages(rag, manifest)
        else:
            p = WIKI_DIR / key
            print(f"  reindexing {key} ({why})", flush=True)
            if reason := await _index_one(rag, p):
                print(f"    FAILED: {reason}", flush=True)
            else:
                manifest[str(p)] = p.stat().st_mtime
                save_manifest(manifest)
    await rag.doc_status.index_done_callback()


def show_status(pages: list[Path], manifest: dict) -> None:
    indexed   = sum(1 for p in pages if str(p) in manifest)
    changed   = sum(1 for p in pages
                    if str(p) in manifest and manifest[str(p)] != p.stat().st_mtime)
    unindexed = len(pages) - indexed
    print(f"Pages total:    {len(pages)}")
    print(f"Indexed:        {indexed}")
    print(f"Changed:        {changed}")
    print(f"Not yet:        {unindexed}")
    print(f"Work dir:       {WORK_DIR}")


async def test_llm_backend() -> None:
    print(f"Testing LLM backend: {LLM_MODEL}")
    try:
        # deepseek-v4.1-flash is a reasoning model: reasoning tokens count against max_tokens,
        # so a tiny cap (16) can be fully spent on thinking and return empty content.
        result = await _llm_func("Reply with the single word OK.", max_tokens=1024)
        # result may be a string or an async generator (streaming)
        if hasattr(result, "__aiter__"):
            text = "".join([chunk async for chunk in result])
        else:
            text = str(result)
        print(f"  response: {text.strip()!r}  ✓")
    except Exception as e:
        print(f"  FAILED: {e}")
        raise SystemExit(1)


async def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--full",   action="store_true", help="wipe and rebuild")
    parser.add_argument("--status", action="store_true", help="show stats only")
    parser.add_argument("--test",   action="store_true", help="test LLM backend then exit")
    parser.add_argument("--yes",    action="store_true", help="skip cost confirmation for --full with API key")
    parser.add_argument("--verify", action="store_true", help="compare the index with the wiki on disk; exit 1 on differences")
    parser.add_argument("--reconcile", action="store_true", help="repair what --verify reports (re-indexes pages; needs the LLM)")
    args = parser.parse_args()

    pages = sorted(WIKI_PAGES.rglob("*.md"))

    if args.status:
        show_status(pages, load_manifest())
        return

    if args.test:
        await test_llm_backend()
        return

    if args.verify or args.reconcile:
        if args.reconcile and _llm_func is _no_backend:
            print(_NO_BACKEND_MSG)
            raise SystemExit(1)
        rag, manifest = await make_rag(), load_manifest()
        try:
            problems = await find_problems(rag, pages, manifest)
            for key, why in problems:
                print(f"  {key}: {why}")
            if args.reconcile and problems:
                await reconcile(rag, problems, manifest)
                problems = await find_problems(rag, pages, manifest)
        finally:
            await rag.finalize_storages()
        print(f"{len(problems)} problem(s) remain." if problems else "Index matches the wiki.")
        raise SystemExit(1 if problems else 0)

    if _llm_func is _no_backend:  # checked before --full wipes the existing index
        print(_NO_BACKEND_MSG)
        raise SystemExit(1)

    if args.full and not args.yes:
        print(f"WARNING: --full with OpenCode Go ({_OPENCODE_MODEL}) on {len(pages)} pages.")
        print(f"  LightRAG runs 3 extraction phases per page → may exhaust the 5-hour/weekly usage limit.")
        print(f"  Pass --yes to confirm and proceed.")
        raise SystemExit(1)

    if args.full and WORK_DIR.exists():
        import shutil
        shutil.rmtree(WORK_DIR)
        print("Wiped existing index.")

    rag      = await make_rag()
    manifest = {} if args.full else load_manifest()
    try:
        await remove_deleted_pages(rag, manifest)
        await index_pages(rag, pages, manifest)
    finally:
        await rag.finalize_storages()


if __name__ == "__main__":
    asyncio.run(main())
