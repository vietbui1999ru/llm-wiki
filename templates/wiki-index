#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "lightrag-hku",
#   "ollama",
#   "numpy",
#   "python-dotenv",
# ]
# ///
"""wiki-index — build/update LightRAG graph index over the wiki

Usage:
  wiki-index            index new/changed pages (incremental)
  wiki-index --full     wipe and rebuild from scratch
  wiki-index --status   show manifest stats without indexing

Extraction backend (set env var before running):
  ANTHROPIC_API_KEY=sk-...  → Claude Haiku (better entity/relation extraction)
  unset                     → qwen2.5:3b via ollama (fully local, free)

Requires:
  uv run --script wiki-index   (deps declared inline above)
  ollama running with qwen2.5:3b + nomic-embed-text
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
from pathlib import Path

try:
    import ollama as _ollama
    from dotenv import load_dotenv
    from lightrag import LightRAG, QueryParam
    from lightrag.llm.ollama import ollama_model_complete
    from lightrag.llm.anthropic import anthropic_complete_if_cache
    from lightrag.utils import EmbeddingFunc
except ImportError:
    print("Missing: pip install lightrag-hku python-dotenv")
    sys.exit(1)

WIKI_DIR    = Path.home() / "repos/llm-wiki"
load_dotenv(WIKI_DIR / ".env")
WIKI_PAGES  = WIKI_DIR / "wiki"
WORK_DIR    = WIKI_DIR / ".lightrag"
MANIFEST    = WORK_DIR / "manifest.json"
EMBED_MODEL = "nomic-embed-text"
EMBED_DIM   = 768

_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
if _API_KEY:
    LLM_MODEL      = "claude-haiku-4-5-20251001"
    _llm_func      = anthropic_complete_if_cache
    _llm_max_async = 4
else:
    LLM_MODEL      = "qwen2.5:3b"
    _llm_func      = ollama_model_complete
    _llm_max_async = 2


async def _embed(texts: list[str]):
    import numpy as np
    loop = asyncio.get_event_loop()
    resp = await loop.run_in_executor(
        None, lambda: _ollama.embed(model=EMBED_MODEL, input=texts)
    )
    return np.array(resp.embeddings, dtype=np.float32)


def _build_rag() -> LightRAG:
    WORK_DIR.mkdir(exist_ok=True)
    return LightRAG(
        working_dir=str(WORK_DIR),
        llm_model_func=_llm_func,
        llm_model_name=LLM_MODEL,
        llm_model_max_async=_llm_max_async,
        max_extract_input_tokens=16384,
        # Wiki pages are focused (1 concept/page, ~300-800 tokens).
        # chunk_token_size=800 keeps most pages as a single chunk — preserves
        # the "one concept per page" property rather than splitting across chunks.
        chunk_token_size=800,
        chunk_overlap_token_size=64,
        # top_k=20 (down from default 40): wiki has dense cross-links so
        # graph traversal finds related nodes quickly; fewer candidates = less noise.
        top_k=20,
        cosine_threshold=0.3,
        embedding_func=EmbeddingFunc(
            embedding_dim=EMBED_DIM,
            max_token_size=8192,
            func=_embed,
        ),
    )


async def make_rag() -> LightRAG:
    rag = _build_rag()
    await rag.initialize_storages()
    return rag


def load_manifest() -> dict:
    if MANIFEST.exists():
        return json.loads(MANIFEST.read_text())
    return {}


def save_manifest(m: dict) -> None:
    MANIFEST.write_text(json.dumps(m, indent=2))


def page_content(path: Path) -> str:
    rel = path.relative_to(WIKI_DIR)
    return f"# Source: {rel}\n\n{path.read_text()}"


async def index_pages(rag: LightRAG, pages: list[Path], manifest: dict) -> dict:
    changed = [
        p for p in pages
        if str(p) not in manifest
        or manifest[str(p)] != p.stat().st_mtime
    ]

    if not changed:
        print("Index up to date — no changes detected.")
        return manifest

    backend = "anthropic" if _API_KEY else "ollama"
    print(f"Indexing {len(changed)} new/changed pages (of {len(pages)} total) · extraction: {LLM_MODEL} ({backend})")
    for i, p in enumerate(changed, 1):
        rel = p.relative_to(WIKI_DIR)
        print(f"  [{i}/{len(changed)}] {rel}", flush=True)
        await rag.ainsert(
            page_content(p),
            ids=[str(rel)],
            file_paths=[str(rel)],
        )
        manifest[str(p)] = p.stat().st_mtime
        save_manifest(manifest)   # save after each page so partial runs resume

    print(f"Done. {len(changed)} pages indexed.")
    return manifest


def show_status(pages: list[Path], manifest: dict) -> None:
    indexed   = sum(1 for p in pages if str(p) in manifest)
    changed   = sum(1 for p in pages
                    if str(p) in manifest and manifest[str(p)] != p.stat().st_mtime)
    unindexed = len(pages) - indexed
    print(f"Pages total:    {len(pages)}")
    print(f"Indexed:        {indexed}")
    print(f"Changed:        {changed}")
    print(f"Not yet:        {unindexed}")
    print(f"Work dir:       {WORK_DIR}")


async def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--full",   action="store_true", help="wipe and rebuild")
    parser.add_argument("--status", action="store_true", help="show stats only")
    args = parser.parse_args()

    pages = sorted(WIKI_PAGES.rglob("*.md"))

    if args.status:
        show_status(pages, load_manifest())
        return

    if args.full and WORK_DIR.exists():
        import shutil
        shutil.rmtree(WORK_DIR)
        print("Wiped existing index.")

    rag      = await make_rag()
    manifest = {} if args.full else load_manifest()
    try:
        await index_pages(rag, pages, manifest)
    finally:
        await rag.finalize_storages()


if __name__ == "__main__":
    asyncio.run(main())
