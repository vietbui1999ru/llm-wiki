#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "lightrag-hku>=1.5.7,<1.6",   # tested on 1.5.7; constructor kwargs moved between releases
#   "openai",
#   "mcp>=1.0,<2",   # 2.x removed the @app.list_tools()/@app.call_tool() decorators used below
#   "ollama",
#   "numpy",
#   "python-dotenv",
# ]
# ///
"""wiki-mcp — local MCP server: graph-aware wiki queries via LightRAG

Retrieval always runs locally (nomic-embed-text + graph traversal, zero cost).
Synthesis backend (first one configured wins):
  LLAMACPP_BASE_URL=...             → self-hosted llama.cpp (RESERVED — not wired yet, errors if set)
  OPENCODE_GO_API_KEY_LIGHTRAG=...  → OpenCode Go (OpenAI-compatible, flat monthly plan)
      OPENCODE_LIGHTRAG_MODEL       model id (default deepseek-v4.1-flash)
      OPENCODE_LIGHTRAG_BASE_URL    default https://opencode.ai/zen/go/v1
      OPENCODE_LIGHTRAG_SESSION     routing/prefix-cache affinity id (default: wiki-mcp)
  WIKI_LLM_PROXY_URL=...            send synthesis through a local proxy (see docs/headroom.md)
  OPENROUTER_API_KEY=sk-or-...      → OpenRouter (not yet implemented — stub only)
  none configured                   → wiki_query returns an error; wiki_status still works

Requires:
  uv run --script wiki-mcp   (deps declared inline above)
  ollama running with nomic-embed-text (embeddings only; no local LLM is used)
  wiki-index run at least once to build the graph
"""
from __future__ import annotations

import asyncio
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

try:
    import numpy as np
    import ollama as _ollama
    from dotenv import load_dotenv
    from lightrag import LightRAG, QueryParam
    from lightrag.llm.openai import openai_complete_if_cache
    from lightrag.utils import EmbeddingFunc
    from mcp.server import Server
    from mcp.server.stdio import stdio_server
    from mcp import types
except ImportError as e:
    print(f"Missing: {e}", file=sys.stderr)
    sys.exit(1)

WIKI_DIR    = Path.home() / "repos/llm-wiki"
load_dotenv(WIKI_DIR / ".env")
WORK_DIR    = WIKI_DIR / ".lightrag"
EMBED_MODEL = "nomic-embed-text"
EMBED_DIM   = 768

# Synthesis backend: local llama.cpp slot (reserved) -> OpenCode Go -> none
def _secret(name: str) -> str:
    """The env value, else one key via dotfiles' secret-get. Nothing sources ~/secrets/.env
    (dotfiles docs/workflows/secrets.md), so a key is fetched only by the tool that needs it."""
    if os.environ.get(name):
        return os.environ[name]
    tool = shutil.which("secret-get") or str(Path.home() / "dotfiles/scripts/secret-get")
    try:
        out = subprocess.run([tool, name], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


_API_KEY        = _secret("OPENCODE_GO_API_KEY_LIGHTRAG")
_OPENCODE_URL    = os.environ.get("OPENCODE_LIGHTRAG_BASE_URL", "https://opencode.ai/zen/go/v1")
_OPENCODE_MODEL  = os.environ.get("OPENCODE_LIGHTRAG_MODEL", "deepseek-v4.1-flash")
_OPENROUTER_KEY  = os.environ.get("OPENROUTER_API_KEY", "")
# deepseek-v4.1-flash reasons by default and can spend the whole max_tokens budget on thinking
# (empty content, finish_reason=length). Send thinking={"type":"disabled"}; set to 0 to omit.
_DISABLE_THINKING = os.environ.get("OPENCODE_LIGHTRAG_DISABLE_THINKING", "1") == "1"

# OpenCode Go asks clients to identify themselves and send a stable session id
# (https://opencode.ai/docs/go/#where-can-i-use-it) so routing/prompt caching work.
# OpenCode Go requires a session id and uses it for routing/prefix-cache affinity.
# Stable by default so consecutive runs share the namespace; override per experiment.
_SESSION = os.environ.get("OPENCODE_LIGHTRAG_SESSION", "wiki-mcp")
_PROXY_URL = os.environ.get("WIKI_LLM_PROXY_URL", "")
_BASE_URL = _PROXY_URL or _OPENCODE_URL
_OPENCODE_HEADERS: dict[str, str] = {
    "User-Agent": "llm-wiki-lightrag/1.0",
    "x-opencode-session": _SESSION,
}
if _PROXY_URL:  # stack attribution + session grouping in the proxy's /stats
    _OPENCODE_HEADERS["x-headroom-stack"] = "llm_wiki_mcp"
    _OPENCODE_HEADERS["x-headroom-session-id"] = _SESSION

def _preflight_proxy() -> None:
    """Fail closed: a dead or foreign listener must never receive provider credentials.

    /health answers 200 even when unhealthy, so identity comes from /livez (service name) and
    readiness from /readyz. See docs/headroom.md.
    """
    import json as _json
    import urllib.error
    import urllib.request

    root = _PROXY_URL.rstrip("/")
    if root.endswith("/v1"):
        root = root[: -len("/v1")]
    try:
        with urllib.request.urlopen(f"{root}/livez", timeout=3) as resp:
            identity = _json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as exc:  # something answered, but not with an identity document
        raise SystemExit(
            f"{root}/livez answered HTTP {exc.code}; that is not a Headroom proxy. "
            "Refusing to send provider credentials there."
        )
    except Exception as exc:
        raise SystemExit(
            f"Headroom proxy not reachable at {root} ({exc}).\n"
            "Start it (docs/headroom.md) or unset WIKI_LLM_PROXY_URL to call the provider directly."
        )
    if identity.get("service") != "headroom-proxy":
        raise SystemExit(
            f"{root} answered but is not a Headroom proxy (service={identity.get('service')!r}). "
            "Refusing to send provider credentials there."
        )

async def _opencode_llm(prompt, system_prompt=None, history_messages=None, **kwargs):
    kwargs.setdefault("max_tokens", 4096)
    if _DISABLE_THINKING:
        kwargs.setdefault("extra_body", {"thinking": {"type": "disabled"}})
    result = await openai_complete_if_cache(
        _OPENCODE_MODEL, prompt,
        system_prompt=system_prompt,
        history_messages=history_messages or [],
        base_url=_BASE_URL,
        api_key=_API_KEY,
        extra_headers=_OPENCODE_HEADERS,  # per-request; LightRAG overwrites client-level default_headers
        **kwargs,
    )
    if hasattr(result, "__aiter__"):
        return "".join([chunk async for chunk in result])
    return result

async def _no_backend(*args, **kwargs):
    raise RuntimeError("No LLM backend configured. Set OPENCODE_GO_API_KEY_LIGHTRAG (in ~/secrets/.env).")

_LOCAL_LLM_URL = os.environ.get("LLAMACPP_BASE_URL", "")  # empty = no local backend

if _LOCAL_LLM_URL:
    # TODO: self-hosted llama.cpp (llama-server exposes an OpenAI-compatible /v1 API).
    # Slot is intentionally left empty until an instance exists.
    raise NotImplementedError("llama.cpp backend not wired yet. Unset LLAMACPP_BASE_URL.")
elif _API_KEY:
    LLM_MODEL      = _OPENCODE_MODEL
    _llm_func      = _opencode_llm
    _llm_max_async = 4
elif _OPENROUTER_KEY:
    # TODO: wire up OpenRouter backend via lightrag.llm.openai.openai_complete_if_cache
    # base_url="https://openrouter.ai/api/v1"
    raise NotImplementedError("OpenRouter backend not yet implemented. Set OPENCODE_GO_API_KEY_LIGHTRAG.")
else:
    LLM_MODEL      = "none"
    _llm_func      = _no_backend
    _llm_max_async = 1

_rag: LightRAG | None = None


async def _embed(texts: list[str]):
    loop = asyncio.get_event_loop()
    resp = await loop.run_in_executor(
        None, lambda: _ollama.embed(model=EMBED_MODEL, input=texts)
    )
    return np.array(resp.embeddings, dtype=np.float32)


async def get_rag() -> LightRAG:
    global _rag
    if _rag is not None:
        return _rag
    if _PROXY_URL:
        _preflight_proxy()
    if not WORK_DIR.exists():
        raise RuntimeError("Wiki index not found. Run: wiki-index")
    _rag = LightRAG(
        working_dir=str(WORK_DIR),
        llm_model_func=_llm_func,
        llm_model_name=LLM_MODEL,
        llm_model_max_async=_llm_max_async,
        chunk_token_size=800,
        chunk_overlap_token_size=64,
        top_k=20,
        cosine_better_than_threshold=0.3,
        embedding_func=EmbeddingFunc(
            embedding_dim=EMBED_DIM,
            max_token_size=8192,
            func=_embed,
        ),
    )
    await _rag.initialize_storages()
    return _rag


app = Server("wiki-mcp")


@app.list_tools()
async def list_tools() -> list[types.Tool]:
    return [
        types.Tool(
            name="wiki_query",
            description=(
                "Query the personal LLM wiki using graph-aware RAG (LightRAG)."
                "Returns a synthesized answer from the knowledge graph (counts against the OpenCode Go plan limits)."
                "Better than keyword search for concept questions, cross-topic synthesis, "
                "and relationship queries. "
                "mode: hybrid=entity+community graph (default), "
                "local=specific concept/entity, global=big-picture cross-concept, naive=flat vector"
            ),
            inputSchema={
                "type": "object",
                "required": ["question"],
                "properties": {
                    "question": {"type": "string", "description": "The question to answer from the wiki"},
                    "mode": {
                        "type": "string",
                        "enum": ["hybrid", "local", "global", "naive"],
                        "default": "hybrid",
                    },
                },
            },
        ),
        types.Tool(
            name="wiki_status",
            description="Show wiki index stats: pages indexed, model in use, work dir.",
            inputSchema={"type": "object", "properties": {}},
        ),
    ]


@app.call_tool()
async def call_tool(name: str, arguments: dict) -> list[types.TextContent]:
    if name == "wiki_query":
        rag    = await get_rag()
        result = await rag.aquery(
            arguments["question"],
            param=QueryParam(mode=arguments.get("mode", "hybrid")),
        )
        return [types.TextContent(type="text", text=result)]

    if name == "wiki_status":
        manifest_path = WORK_DIR / "manifest.json"
        if not manifest_path.exists():
            return [types.TextContent(type="text", text="No index. Run: wiki-index")]
        manifest = json.loads(manifest_path.read_text())
        pages    = list((WIKI_DIR / "wiki").rglob("*.md"))
        indexed  = sum(1 for p in pages if str(p) in manifest)
        text     = f"Pages: {len(pages)} total · {indexed} indexed · model: {LLM_MODEL} · dir: {WORK_DIR}"
        return [types.TextContent(type="text", text=text)]

    raise ValueError(f"Unknown tool: {name}")


async def main() -> None:
    async with stdio_server() as (read_stream, write_stream):
        await app.run(
            read_stream,
            write_stream,
            app.create_initialization_options(),
        )


if __name__ == "__main__":
    asyncio.run(main())
